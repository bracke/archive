en.command.archive.open.name = Open Archive
en.command.archive.open.description = Open a local archive file.
en.command.archive.new.name = New Archive
en.command.archive.new.description = Create a new archive through a validated write plan.
en.command.archive.close.name = Close Archive
en.command.archive.close.description = Close the current archive.
en.command.archive.reload.name = Reload Archive
en.command.archive.reload.description = Reload the current archive from disk.
en.command.archive.open_recent.name = Open Recent Archive
en.command.archive.open_recent.description = Open an archive from recent items.
en.command.archive.save.name = Save Archive
en.command.archive.save.description = Publish pending archive changes safely.
en.command.archive.save_as.name = Save Archive As
en.command.archive.save_as.description = Publish the current archive to a new destination.
en.command.archive.discard_changes.name = Discard Changes
en.command.archive.discard_changes.description = Discard pending archive changes that have not been saved.
en.command.archive.add_files.name = Add Files
en.command.archive.add_files.description = Add files to the archive through a validated write plan.
en.command.archive.add_directory.name = Add Directory
en.command.archive.add_directory.description = Add a directory tree to the archive through a validated write plan.
en.command.archive.replace_selected.name = Replace Selected
en.command.archive.replace_selected.description = Replace the selected file through a validated archive rewrite plan.
en.command.archive.remove_selected.name = Remove Selected
en.command.archive.remove_selected.description = Remove selected entries through a validated archive rewrite plan.
en.command.archive.rename_selected.name = Rename Selected
en.command.archive.rename_selected.description = Rename the selected entry through a validated archive rewrite plan.
en.command.navigate.back.name = Back
en.command.navigate.back.description = Navigate to the previous archive location.
