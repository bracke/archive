en.command.navigate.parent.description = Navigate to the parent virtual directory.
en.command.navigate.root.name = Archive Root
en.command.navigate.root.description = Navigate to the archive root.
en.command.entry.activate.name = Open Entry
en.command.entry.activate.description = Open the selected virtual directory or previewable entry.
en.command.entry.preview.name = Preview Entry
en.command.entry.preview.description = Preview the selected entry.
