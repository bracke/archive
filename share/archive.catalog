default_locale = en
en.application.title = archive
en.application.version = archive 0.1.0-dev
en.help.summary = archive is a graphical archive manager.
en.runtime.backend.headless = headless guikit shell
en.format.tar.name = TAR
en.format.tar.description = POSIX tar archive handled through tarlib.
en.format.tar.gz.name = TAR gzip
en.format.tar.gz.description = gzip-compressed TAR archive handled through zlib and tarlib.
en.format.zip.name = ZIP
en.format.zip.description = ZIP archive with stored and DEFLATE entries.
en.format.gzip.name = gzip
en.format.gzip.description = Standalone gzip stream exposed as one logical file.
en.format.7z.name = 7z
en.format.7z.description = 7z archive supported for native zlib-backed layouts.
en.format.rar.name = RAR
en.format.rar.description = RAR archive; recognized but unsupported in this version.
en.format.xz.name = XZ
en.format.xz.description = XZ stream with one LZMA2 block exposed as one logical file with single-file publication.
en.format.bzip2.name = bzip2
en.format.bzip2.description = bzip2 stream exposed as one logical archive file.
en.format.zstd.name = Zstandard
en.format.zstd.description = Zstandard stream exposed as one logical archive file.
en.format.cab.name = CAB
en.format.cab.description = CAB archive with bounded stored and MSZIP file payloads.
en.format.cpio.name = CPIO
en.format.cpio.description = CPIO newc archive with stored members.
en.format.iso.name = ISO
en.format.iso.description = ISO 9660 image with stored directory records and file extents.
en.format.ar.name = AR
en.format.ar.description = Unix ar archive with stored members.
en.format.split_zip.name = split ZIP
en.format.split_zip.description = Split or spanning ZIP archive; recognized but unsupported in this version.
en.unavailable.encrypted = Encrypted entries cannot be previewed or extracted in this version.
en.unavailable.unsupported_method = This entry uses an unsupported compression method.
en.unavailable.unsafe_path = This entry has an unsafe archive path.
en.unavailable.unsupported_entry_kind = This entry kind cannot be previewed or extracted in this version.
