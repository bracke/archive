with "config/archive_tests_config.gpr";
project Archive_Tests is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Archive_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("archive_tests.adb", "check_all.adb", "release_report.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Archive_Tests_Config.Ada_Compiler_Switches & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnatwU");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;

   package Linker is
      case Archive_Tests_Config.Alire_Host_OS is
         when "macos" =>
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-framework", "CoreFoundation", "-framework", "CoreServices",
               "-framework", "Foundation");
         when "windows" =>
            for Default_Switches ("Ada") use
              ("-lvulkan-1", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0",
               "-lshell32", "-lole32", "-lkernel32");
         when others =>
            for Default_Switches ("Ada") use
              ("-lvulkan", "-lgdk_pixbuf-2.0", "-lgobject-2.0", "-lglib-2.0");
      end case;
   end Linker;

   package Builder is
      for Executable ("archive_tests.adb") use "archive_tests";
      for Executable ("check_all.adb") use "check_all";
      for Executable ("release_report.adb") use "release_report";
   end Builder;

end Archive_Tests;
